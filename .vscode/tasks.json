{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Server",
      "type": "shell",
      "command": "make",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build & Run Server",
      "type": "shell",
      "command": "make && ./build/server",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Init DB",
      "type": "shell",
      "command": "sqlite3 database/osint_cache.db < database/schema.sql && echo 'DB initialized'",
      "problemMatcher": []
    }
  ]
}
